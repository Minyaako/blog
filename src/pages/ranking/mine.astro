---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Frame from '../../components/ranking/Frame.astro'
import SubmissionList from '../../components/ranking/SubmissionList.astro'
import Pagination from '../../components/ranking/Pagination.astro'
import { readRankingIdentity } from '../../server/ranking/http'
import { getRankingStore } from '../../server/ranking/runtime'
import { RankingError, type RankingSubmission } from '../../lib/ranking'
export const prerender = false
Astro.response.headers.set('Cache-Control', 'private, no-store')
const page = Math.max(1, Math.min(10000, Number.parseInt(Astro.url.searchParams.get('page') || '1') || 1))
let entries: RankingSubmission[] = [], error = '', renderedUser = ''
try { const { user } = await readRankingIdentity(Astro.cookies); renderedUser = user?.id || ''; if (!user) { Astro.response.status = 401; error = '登录后可以查看你的投稿。' } else entries = getRankingStore().listSubmissions(user.id, { page }) }
catch (e) { Astro.response.status = e instanceof RankingError ? e.status : 503; error = '投稿暂时无法读取，请稍后重试。' }
---
<BaseLayout title="我的投稿" noindex><Frame renderedUser={renderedUser}><header class="ranking-header"><p class="ranking-eyebrow">MY SUBMISSIONS</p><h1>我的投稿</h1><p>审核进度、退回原因与已发布的版本，都在这里。</p></header>
{error ? <p class="ranking-empty">{error}</p> : <><SubmissionList entries={entries} /><Pagination page={page} count={entries.length} /></>}
</Frame></BaseLayout>
