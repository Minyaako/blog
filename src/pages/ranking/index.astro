---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Frame from '../../components/ranking/Frame.astro'
import Pagination from '../../components/ranking/Pagination.astro'
import { rankingCategories, RankingError, type PublicRanking } from '../../lib/ranking'
import { getRankingStore } from '../../server/ranking/runtime'
export const prerender = false
Astro.response.headers.set('Cache-Control', 'no-store')
const page = Math.max(1, Math.min(10000, Number.parseInt(Astro.url.searchParams.get('page') || '1') || 1))
const categoryId = Astro.url.searchParams.get('category') || undefined
let entries: PublicRanking[] = [], error = ''
try { entries = getRankingStore().listPublic({ categoryId, page }) } catch (e) { Astro.response.status = e instanceof RankingError ? e.status : 503; error = '榜单暂时无法读取，请稍后重试。' }
---
<BaseLayout title="社区榜单" description="把喜好排成榜单，分享你的顺序与理由。" noindex={!!error}>
  <Frame>
    <header class="ranking-header"><p class="ranking-eyebrow">COMMUNITY / RANKING</p><h1>你的顺序，你的理由。</h1><p>发现大家的榜单，或从一份喜欢的榜单开始，排出自己的版本。</p><a class="ranking-primary ranking-button" href="/ranking/new/" data-astro-reload>创建我的榜单</a></header>
    <nav class="ranking-filters" aria-label="按分类筛选"><a href="/ranking/" aria-current={!categoryId ? 'page' : undefined} data-astro-reload>全部</a>{rankingCategories.map(c => <a href={`/ranking/?category=${c.id}`} aria-current={categoryId === c.id ? 'page' : undefined} data-astro-reload>{c.name}</a>)}</nav>
    {error ? <p class="ranking-empty" role="alert">{error}</p> : entries.length ? <ol class="ranking-directory">{entries.map(entry => <li><a href={`/ranking/${entry.ranking.id}/`} data-astro-reload><strong>{entry.version.payload.title}</strong><span>{entry.version.payload.description}</span><span class="ranking-muted">{entry.author.displayName} · {entry.version.payload.items.length} 项 · 第 {entry.version.number} 版</span></a></li>)}</ol> : <div class="ranking-empty"><h2>这里还没有榜单</h2><p>第一份好榜单，可以从你的喜好开始。</p></div>}
    <Pagination page={page} count={entries.length} />
  </Frame>
</BaseLayout>
