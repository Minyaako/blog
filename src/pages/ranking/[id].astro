---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Frame from '../../components/ranking/Frame.astro'
import Editor from '../../components/ranking/Editor.astro'
import Pagination from '../../components/ranking/Pagination.astro'
import { RankingError, rankingCategories, rankingDiff, type PublicRanking, type RankingVersion } from '../../lib/ranking'
import { getRankingStore } from '../../server/ranking/runtime'
export const prerender = false
Astro.response.headers.set('Cache-Control', 'no-store')
const id = Astro.params.id!
const versionId = Astro.url.searchParams.get('version') || undefined
const page = Math.max(1, Math.min(10000, Number.parseInt(Astro.url.searchParams.get('historyPage') || '1') || 1))
let entry: PublicRanking | null = null, versions: RankingVersion[] = [], diff: string[] = [], error = ''
try {
  if (id === 'visual-novels' || id === 'restaurants') throw new RankingError(410, '示例已结束')
  const store = getRankingStore()
  entry = store.getPublicRanking(id, versionId)
  versions = store.listVersions(id, page)
  if (entry.version.parentVersionId) diff = rankingDiff(store.getPublicRanking(id, entry.version.parentVersionId).version.payload, entry.version.payload)
} catch (e) {
  entry = null
  const status = e instanceof RankingError ? e.status : 503
  Astro.response.status = status
  error = status === 410 ? (id === 'visual-novels' || id === 'restaurants' ? '示例已结束' : '这份榜单已下架') : status === 404 || status === 422 ? '找不到这份榜单或版本' : '榜单暂时无法读取，请稍后重试。'
  if (status === 422) Astro.response.status = 404
}
---
<BaseLayout title={entry?.version.payload.title || error} description={entry?.version.payload.description || '社区榜单'} noindex={!!versionId || !entry} canonicalUrl={versionId && entry ? `/ranking/${id}/?version=${entry.version.id}` : `/ranking/${id}/`}>
  <Frame>
    {entry ? <>
      <header class="ranking-header">
        <p class="ranking-eyebrow">{rankingCategories.find(c => c.id === entry!.version.payload.categoryId)?.name || entry.version.payload.categoryId} / 第 {entry.version.number} 版</p>
        <h1>{entry.version.payload.title}</h1><p class="ranking-prose">{entry.version.payload.description}</p>
        <p class="ranking-muted">{entry.author.displayName} · <time datetime={entry.version.publishedAt}>{new Date(entry.version.publishedAt).toLocaleDateString('zh-CN')}</time></p>
        {versionId && <p class="ranking-notice">正在查看历史版本。<a href={`/ranking/${id}/`} data-astro-reload>返回当前版本</a></p>}
        {entry.source && <p class="ranking-source">{entry.source.hidden ? '来源榜单已下架' : <>基于 <a href={`/ranking/${entry.source.rankingId}/?version=${entry.source.versionId}`} data-astro-reload>{entry.source.title || '来源榜单'}</a> 创作</>}</p>}
      </header>
      <Editor payload={entry.version.payload} source={{ rankingId: id, versionId: entry.version.id }} ownerId={entry.ranking.ownerId} current={!versionId} />
      <details class="ranking-history" open={Astro.url.searchParams.has('historyPage')}><summary>版本历史</summary><ol>{versions.map(v => <li><a href={`/ranking/${id}/?version=${v.id}`} data-astro-reload>第 {v.number} 版</a> · <time datetime={v.publishedAt}>{new Date(v.publishedAt).toLocaleDateString('zh-CN')}</time>{v.payload.changeNote && <p>{v.payload.changeNote}</p>}</li>)}</ol><Pagination page={page} count={versions.length} param="historyPage" /></details>
      {diff.length > 0 && <details class="ranking-history"><summary>这一版改了什么</summary><ul>{diff.map(line => <li>{line}</li>)}</ul></details>}
    </> : <div class="ranking-empty"><h1>{error}</h1><a href="/ranking/" data-astro-reload>返回全部榜单</a></div>}
  </Frame>
</BaseLayout>
