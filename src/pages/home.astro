---
import BaseLayout from '../layouts/BaseLayout.astro'
import ContactLinks from '../components/ContactLinks.astro'
import { resolveMedia } from '../lib/media'
const avatar = resolveMedia('profile-avatar')
---
<BaseLayout title="Minyako 的个人主页" description="Minyako，西安交通大学人工智能学生。关注 SNN 与 MARL，记录技术、生活和游戏。">
  <div class="personal-home">
    <section class="home-intro" aria-labelledby="home-title">
      <div class="intro-copy"><p class="eyebrow"><img src="/favicon.svg" width="26" height="26" alt="" /> A little corner of Gensokyo</p><h1 id="home-title">你好，我是<br /><span>Minyako</span><span class="name-dot">.</span></h1><p class="intro-description">西安交通大学 · 人工智能学生<br />在研究、代码与幻想之间，记录一些喜欢的事。</p><a class="home-primary" href="/">走进我的博客 <span aria-hidden="true">↗</span></a></div>
      <figure class="portrait"><div class="portrait-frame"><img src={avatar.url} alt="Minyako 的头像" width={avatar.width} height={avatar.height} /></div><figcaption><span aria-hidden="true">✦</span> 真希望能悠闲度日</figcaption></figure>
    </section>
    <section class="home-routes" aria-labelledby="routes-title"><h2 id="routes-title" class="sr-only">去哪里看看</h2>
      <a href="/academic/"><span class="route-index">01 / RESEARCH</span><h3>SNN &amp; MARL <span aria-hidden="true">↗</span></h3><p>脉冲神经网络与多智能体强化学习。</p></a>
      <a href="/projects/"><span class="route-index">02 / BUILD</span><h3>项目与折腾 <span aria-hidden="true">↗</span></h3><p>把想到的东西，一点点做出来。</p></a>
      <a href="/friends/"><span class="route-index">03 / FRIENDS</span><h3>朋友们 <span aria-hidden="true">↗</span></h3><p>相邻的小世界，偶尔串个门。</p></a>
    </section>
    <section class="home-contact" id="contact" aria-labelledby="contact-title"><div><p class="eyebrow">Leave a little hello</p><h2 id="contact-title">保持联系</h2><p>聊研究、代码，或者只是打个招呼。</p></div><ContactLinks /></section>
  </div>
</BaseLayout>
<style>
  .personal-home { max-width: 62rem; margin: auto; padding-top: 1rem; }
  .home-intro { display: grid; grid-template-columns: 1.4fr 1fr; align-items: center; gap: clamp(2rem, 6vw, 6rem); padding-block: 2rem 4rem; }
  .eyebrow { display: flex; gap: .6rem; align-items: center; color: var(--accent); font: .72rem/1.6 var(--font-mono); letter-spacing: .06em; }
  h1 { margin: 1.4rem 0; font: 720 clamp(2.25rem, 5vw, 4.5rem)/1.2 var(--font-display); letter-spacing: -.035em; }
  h1 > span { font-size: 1.22em; }.name-dot { color: var(--accent); }
  .intro-description { line-height: 1.9; color: var(--text-muted); font-size: .95rem; }
  .home-primary { display: inline-flex; gap: 2.25rem; align-items: center; min-height: 48px; padding: .7rem 1.1rem; margin-top: .9rem; background: var(--accent); color: var(--canvas); border-radius: var(--radius-sm); font-size: .85rem; font-weight: 600; text-decoration: none; }
  .home-primary:hover { filter: brightness(1.1); }
  .portrait { max-width: 18rem; margin: 0; justify-self: end; }
  .portrait-frame { padding: .65rem; border: 1px solid var(--border-strong); border-radius: 46% 46% .75rem .75rem; background: var(--surface); transform: rotate(3deg); }
  .portrait img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 46% 46% .35rem .35rem; }
  figcaption { display: flex; align-items: center; justify-content: center; gap: .65rem; padding-top: 1.5rem; color: var(--text-muted); font: .78rem/1.6 var(--font-mono); }
  figcaption span { color: var(--accent); }
  .home-routes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-block: 1px solid var(--border-strong); }
  .home-routes > a { min-width: 0; padding: 2rem 1.25rem; text-decoration: none; transition: background var(--duration-fast); }
  .home-routes > a:first-of-type { padding-left: 0; }
  .home-routes > a + a { border-left: 1px solid var(--border); }
  .home-routes > a:hover { background: var(--surface); }
  .route-index { font: .7rem/1.6 var(--font-mono); color: var(--text-muted); }
  h3 { display: flex; justify-content: space-between; gap: .5rem; margin: 1rem 0 .6rem; font-size: 1.12rem; }
  h3 span { color: var(--accent); font-weight: 400; }
  .home-routes p { margin: 0; color: var(--text-muted); font-size: .82rem; line-height: 1.8; }
  .home-contact { display: grid; grid-template-columns: .9fr 1.4fr; gap: 2rem; padding-top: 3.5rem; scroll-margin-top: 10rem; }
  h2 { font: 700 1.7rem/1.3 var(--font-display); margin: 1rem 0; }
  .home-contact p:last-child { color: var(--text-muted); font-size: .85rem; line-height: 1.8; }
  @media(max-width: 44rem) { .home-intro { grid-template-columns: 1fr; padding-top: 0; gap: 2.5rem; }.portrait { width: 11rem; justify-self: center; }.home-routes { grid-template-columns: 1fr; }.home-routes > a, .home-routes > a:first-of-type { padding: 1.4rem 0; }.home-routes > a + a { border-left: 0; border-top: 1px solid var(--border); }.home-contact { grid-template-columns: 1fr; gap: 1rem; } }
</style>
