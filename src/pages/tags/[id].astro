---
import type { GetStaticPaths } from 'astro'
import MomentCard from '../../components/MomentCard.astro'
import PostCard from '../../components/PostCard.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { buildTagDetailSections } from '../../lib/tag-detail'
import { getPublishedMoments, type MomentView } from '../../lib/moments'
import { getPublishedPosts, toPostCard, type PostCardData } from '../../lib/posts'
import { getAllTags, type Tag } from '../../lib/tags'

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts()
  const moments = await getPublishedMoments()
  return getAllTags().map((tag) => ({
    params: { id: tag.id },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.includes(tag.id)).map(toPostCard),
      moments: moments.filter((moment) => moment.tags.some((item) => item.id === tag.id)),
    }
  }))
}) satisfies GetStaticPaths

interface Props { tag: Tag; posts: PostCardData[]; moments: MomentView[] }
const { tag, posts, moments } = Astro.props
const sections = buildTagDetailSections(tag, posts, moments)
---
<BaseLayout title={`#${tag.label}`} description={tag.description}>
  <div class="listing-page">
    <header>
      <p>Tag · {tag.id}</p>
      <h1>#{tag.label}</h1>
      <span>{tag.description}</span>
      {tag.aliases.length > 0 && <small>别名：{tag.aliases.join('、')}</small>}
    </header>
    <div class="tag-detail-content">
      <section class="tag-detail-section" aria-labelledby="tag-posts-heading">
        <div class="tag-detail-section__header">
          <h2 id="tag-posts-heading">相关文章</h2>
          <p>带有该标签的文章列表。</p>
        </div>
        <div class="cards">
          {sections.hasPosts ? sections.posts.map((post) => <PostCard post={post} />) : <p class="empty">尚无公开文章使用此标签。</p>}
        </div>
      </section>
      <section class="tag-detail-section" aria-labelledby="tag-moments-heading">
        <div class="tag-detail-section__header">
          <h2 id="tag-moments-heading">相关动态</h2>
          <p>带有该标签的动态时间流。</p>
        </div>
        <div class="moments">
          {sections.hasMoments ? sections.moments.map((moment) => <MomentCard moment={moment} />) : <p class="empty">尚无公开动态使用此标签。</p>}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
<style>.listing-page{width:min(100% - 2rem,var(--content-wide));margin-inline:auto;padding-block:var(--space-7)}header{display:grid;gap:var(--space-2);padding-bottom:var(--space-5);border-bottom:1px solid var(--border-strong)}header p{margin:0;color:var(--text-muted);font:var(--text-caption)/1.4 var(--font-mono);text-transform:uppercase}h1{margin:0;font:750 clamp(2rem,6vw,4rem)/1.1 var(--font-display)}header span,header small,.empty,.tag-detail-section__header p{color:var(--text-muted)}.tag-detail-content{display:grid;gap:var(--space-7);margin-top:var(--space-6)}.tag-detail-section{display:grid;gap:var(--space-4)}.tag-detail-section__header{display:grid;gap:var(--space-2)}.tag-detail-section__header h2{margin:0;font:700 1.2rem/1.3 var(--font-display)}.tag-detail-section__header p{margin:0}.cards,.moments{display:grid;gap:var(--space-5)}</style>
