---
import BaseLayout from './BaseLayout.astro'

interface Props {
  title: string
  description: string
  eyebrow?: string
}

const { title, description, eyebrow = 'Moments' } = Astro.props
---

<BaseLayout title={title} description={description}>
  <header class="moment-page-header" data-motion-reveal>
    <p>{eyebrow}</p>
    <h1>{title}</h1>
    <div>{description}</div>
  </header>
  <slot />
</BaseLayout>

<style>
  .moment-page-header { max-width: 48rem; margin: 0 auto var(--space-7); padding-bottom: var(--space-5); border-bottom: 1px solid var(--border-strong); }
  p { margin: 0; color: var(--accent); font: var(--text-caption)/1.4 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
  h1 { margin: var(--space-2) 0 var(--space-3); font: 760 clamp(2rem, 1.5rem + 2vw, 3.4rem)/1.12 var(--font-display); }
  div { max-width: 62ch; color: var(--text-muted); line-height: 1.7; }
</style>
