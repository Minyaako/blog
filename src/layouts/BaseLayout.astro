---
import '@fontsource-variable/manrope/index.css'
import '@fontsource-variable/noto-sans-sc/index.css'
import 'katex/dist/katex.min.css'
import { SITE } from '../config/site'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  image?: string
  noindex?: boolean
}

const {
  title,
  description = SITE.description,
  image,
  noindex = false
} = Astro.props

const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title
const canonical = new URL(Astro.url.pathname, SITE.origin)
const socialImage = image ? new URL(image, SITE.origin) : undefined
const isPreview = import.meta.env.PUBLIC_BLOG_PREVIEW === 'true'
const previewBranch = import.meta.env.PUBLIC_PREVIEW_BRANCH || 'editor-preview'
const previewSha = import.meta.env.PUBLIC_PREVIEW_SHA || 'local-build'
const previewBuildTime = import.meta.env.PUBLIC_PREVIEW_BUILD_TIME || 'local'
---

<!doctype html>
<html lang={SITE.lang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f0e9" />
    {(noindex || isPreview) && <meta name="robots" content="noindex, noarchive" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} RSS`} href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="author" content="Minyako" />
    <slot name="head" />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('minyako-theme')
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches
        document.documentElement.dataset.theme = stored === 'dark' || stored === 'light'
          ? stored
          : systemDark ? 'dark' : 'light'
      })()
    </script>
    <script is:inline>
      (() => {
        const root = document.documentElement
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches
        root.dataset.motionNavigation = reduced
          ? 'instant'
          : typeof document.startViewTransition === 'function' ? 'native' : 'fallback'

        const domain = /^\/domains\/(academic|engineering|life|games)(?:\/|$)/.exec(location.pathname)?.[1]
        if (domain) root.dataset.motionDomain = domain
      })()
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    {isPreview && (
      <aside class="preview-banner" data-preview-banner aria-label="公开预览环境">
        <strong>公开预览</strong>
        <span>分支 {previewBranch}</span>
        <span>提交 <code>{previewSha.slice(0, 12)}</code></span>
        <time datetime={previewBuildTime}>构建于 {previewBuildTime}</time>
        <span>评论与统计已停用</span>
      </aside>
    )}
    <SiteHeader />
    <main class="page-main" id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import { initPageMotion } from '../scripts/page-motion'
      import { initRevealMotion } from '../scripts/motion'
      initPageMotion()
      initRevealMotion()
    </script>
  </body>
</html>

<style is:global>
  .preview-banner {
    position: relative;
    z-index: 30;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .35rem 1rem;
    padding: .65rem 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 45%, var(--border));
    background: color-mix(in srgb, var(--accent) 10%, var(--surface));
    color: var(--text);
    font: 600 var(--text-caption)/1.5 var(--font-mono);
  }
  .preview-banner strong { color: var(--accent); }
  .preview-banner code { font: inherit; }
</style>
