---
interface Props { pageKey: string }
const { pageKey } = Astro.props
const isPreview = import.meta.env.PUBLIC_BLOG_PREVIEW === 'true'
---
<div class="article-views" data-article-views data-page-key={pageKey} data-preview={String(isPreview)} data-pagefind-ignore title="每次打开文章记录一次阅读">
  <img src="/favicon.svg" alt="" width="28" height="28" aria-hidden="true" />
  <span>阅读</span>
  <span class="article-views-value" data-article-views-value role="status" aria-live="polite">{isPreview ? '预览不计数' : '统计中…'}</span>
  <noscript>（启用 JavaScript 后显示）</noscript>
</div>
<script>
  import { installArticleViews } from '../scripts/article-views'
  installArticleViews()
</script>
<style>
  .article-views{display:inline-flex;align-items:center;gap:.45rem;max-width:100%;margin-top:var(--space-4);padding:.25rem .85rem .25rem .35rem;border:1px solid color-mix(in srgb,var(--accent) 23%,var(--border));border-radius:99rem;background:color-mix(in srgb,var(--accent) 5%,var(--surface));color:var(--text-muted);font-size:.78rem;line-height:1.5;vertical-align:middle}
  .article-views img{flex:none;width:1.75rem;height:1.75rem}
  .article-views-value{color:var(--text);font-variant-numeric:tabular-nums}
  .article-views[data-state='disabled'] .article-views-value,.article-views[data-state='error'] .article-views-value{color:var(--text-muted)}
  noscript{font-size:.7rem}
</style>
