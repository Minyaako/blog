---
import type { DomainKey } from '../config/taxonomy'

interface Props {
  domain: DomainKey
  size?: number
}

const { domain, size = 48 } = Astro.props
---

<svg
  class="domain-icon"
  data-domain-icon={domain}
  viewBox="0 0 64 64"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {domain === 'academic' && (
    <>
      <circle cx="32" cy="32" r="6" />
      <ellipse cx="32" cy="32" rx="25" ry="11" />
      <ellipse cx="32" cy="32" rx="11" ry="25" transform="rotate(35 32 32)" />
      <circle class="domain-icon__accent" cx="53" cy="31" r="2.5" fill="currentColor" stroke="none" />
    </>
  )}
  {domain === 'engineering' && (
    <>
      <path d="M22 15 9 32l13 17M42 15l13 17-13 17M37 9 27 55" />
      <circle class="domain-icon__accent" cx="14" cy="32" r="2.5" fill="currentColor" stroke="none" />
    </>
  )}
  {domain === 'life' && (
    <>
      <path d="M17 39c0-14 9-25 29-27 1 20-8 34-25 35M17 52c5-16 14-25 29-36" />
      <circle class="domain-icon__accent" cx="14" cy="51" r="2.5" fill="currentColor" stroke="none" />
    </>
  )}
  {domain === 'games' && (
    <>
      <path d="M11 15h42v29H31L20 54V44h-9zM21 28h10M26 23v10M41 25h.1M46 32h.1" />
      <circle class="domain-icon__accent" cx="49" cy="18" r="2.5" fill="currentColor" stroke="none" />
    </>
  )}
</svg>
