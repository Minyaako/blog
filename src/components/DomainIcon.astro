---
import { Icon } from 'astro-icon/components'
import type { DomainKey } from '../config/taxonomy'

interface Props {
  domain: DomainKey
  size?: number
}

const { domain, size = 48 } = Astro.props

const iconByDomain: Record<DomainKey, string> = {
  academic: 'lucide:book-open-check',
  engineering: 'lucide:cpu',
  life: 'lucide:coffee',
  games: 'lucide:gamepad-2'
}
---

<Icon
  name={iconByDomain[domain]}
  class="domain-icon"
  data-domain-icon={domain}
  size={size}
  is:inline
  aria-hidden="true"
  focusable="false"
  />
