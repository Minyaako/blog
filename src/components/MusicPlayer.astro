---
import library from '../content/music/library.json'
import { parseMusicLibrary, shouldRenderMusicPlayer } from '../lib/music'
import model from 'virtual:blog-music-model'

const musicLibrary = parseMusicLibrary(library)
const enabled = shouldRenderMusicPlayer(musicLibrary)
const MusicPlayerEnabled = enabled ? (await import('./MusicPlayerEnabled.astro')).default : null
---

{MusicPlayerEnabled && model && <MusicPlayerEnabled model={model} />}
