---
import type { MarkdownHeading } from 'astro'
interface Props { headings: MarkdownHeading[] }
const { headings } = Astro.props
const visibleHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3)
---
{visibleHeadings.length > 0 && (
  <nav class="toc" aria-label="文章目录" data-toc>
    <p>On this page</p>
    <span class="toc-marker" data-toc-marker aria-hidden="true"></span>
    <ol>
      {visibleHeadings.map((heading) => (
        <li data-depth={heading.depth}>
          <a href={`#${heading.slug}`} data-toc-link>{heading.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}
<style>
  .toc{font-size:.82rem}p{margin:0 0 var(--space-3);color:var(--text-muted);font:var(--text-caption)/1.4 var(--font-mono);letter-spacing:.1em;text-transform:uppercase}ol{display:grid;gap:var(--space-2);margin:0;padding:0;list-style:none}li[data-depth='3']{padding-left:var(--space-3)}a{display:block;padding-left:var(--space-3);border-left:1px solid var(--border);color:var(--text-muted);line-height:1.45;text-decoration:none}a:hover{color:var(--text)}
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-toc]').forEach((toc) => {
    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'))
    const headings = links
      .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter((heading): heading is HTMLElement => heading !== null)

    const setActive = (id: string, forcePosition = false) => {
      const active = links.find((link) => decodeURIComponent(link.hash.slice(1)) === id)
      if (!active) return

      const sectionChanged = !active.hasAttribute('aria-current')
      if (sectionChanged) {
        links.forEach((link) => link.removeAttribute('aria-current'))
        active.setAttribute('aria-current', 'location')
      }

      if (sectionChanged || forcePosition) {
        toc.style.setProperty('--toc-marker-y', `${active.offsetTop}px`)
        toc.style.setProperty('--toc-marker-height', `${active.offsetHeight}px`)
      }
    }

    if (headings.length === 0) return

    links.forEach((link) => {
      link.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
        setActive(decodeURIComponent(link.hash.slice(1)))
      })
    })

    if ('IntersectionObserver' in window) {
      const intersectingHeadings = new Set<HTMLElement>()
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const heading = entry.target as HTMLElement
          if (entry.isIntersecting) intersectingHeadings.add(heading)
          else intersectingHeadings.delete(heading)
        })
        const firstIntersecting = headings.find((heading) => intersectingHeadings.has(heading))
        if (firstIntersecting) setActive(firstIntersecting.id)
      }, { rootMargin: '-18% 0px -68% 0px', threshold: 0 })

      headings.forEach((heading) => observer.observe(heading))
    }

    const initialId = (() => {
      try {
        return decodeURIComponent(window.location.hash.slice(1))
      } catch {
        return ''
      }
    })()
    const initialHeading = headings.find((heading) => heading.id === initialId) ?? headings[0]
    setActive(initialHeading.id)
    window.addEventListener('resize', () => {
      const current = links.find((link) => link.hasAttribute('aria-current'))
      if (current) setActive(decodeURIComponent(current.hash.slice(1)), true)
    })
  })
</script>
