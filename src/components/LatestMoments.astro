---
import { toMomentSummary, type MomentView } from '../lib/moments'

interface Props {
  moments: MomentView[]
}

const { moments } = Astro.props
const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-CN', { month: 'short', day: 'numeric' }).format(date)
---

<section class="latest-moments" aria-labelledby="latest-moments-heading" data-latest-moments data-motion-reveal style="--motion-order: 3">
  <header>
    <div><p class="kicker">Recent moments</p><h2 id="latest-moments-heading">最新动态</h2></div>
    <a href="/moments">进入时间流 <span class="motion-arrow" aria-hidden="true">→</span></a>
  </header>
  <div class="moment-previews">
    {moments.slice(0, 2).map((moment) => (
      <article data-moment-preview>
        <p><time datetime={moment.publishedAt.toISOString()}>{formatDate(moment.publishedAt)}</time></p>
        <h3><a href={`/moments/${moment.id}`}>{moment.title ?? '一则没有标题的动态'}</a></h3>
        <p>{toMomentSummary(moment, 96)}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .latest-moments { padding-bottom: var(--space-7); }
  header { display: flex; align-items: end; justify-content: space-between; gap: var(--space-4); padding-bottom: var(--space-3); border-bottom: 1px solid var(--border-strong); }
  .kicker, article > p:first-child { margin: 0; color: var(--text-muted); font: var(--text-caption)/1.3 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  h2 { margin: var(--space-2) 0 0; font: 750 var(--text-title)/1.2 var(--font-display); }
  header a { color: var(--text-muted); font-size: .82rem; }
  .moment-previews { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6); }
  article { padding: var(--space-5) 0; border-bottom: 1px solid var(--border); }
  h3 { margin: var(--space-2) 0; font: 680 1rem/1.45 var(--font-display); }
  h3 a { text-decoration: none; }
  h3 a:hover { color: var(--accent); }
  article p:last-child { margin: 0; color: var(--text-muted); line-height: 1.7; }
  @media (max-width: 40rem) { .moment-previews { grid-template-columns: 1fr; gap: 0; } }
</style>
