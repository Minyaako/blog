---
import { resolveMedia } from '../lib/media'

const slides = [
  {
    ...resolveMedia('home-hero-01'),
    alt: '首页横幅：伏案小憩的少女'
  },
  {
    ...resolveMedia('home-hero-02'),
    alt: '首页横幅：花瓣光影中的白发少女'
  }
]
---

<figure class="hero-banner" data-hero-rotator>
  {slides.map((slide, index) => (
    <img
      src={index === 0 ? slide.url : undefined}
      data-hero-src={index === 0 ? undefined : slide.url}
      alt={slide.alt}
      width={slide.width}
      height={slide.height}
      loading="eager"
      fetchpriority={index === 0 ? 'high' : 'low'}
      data-hero-slide
      data-active={index === 0 ? 'true' : 'false'}
      aria-hidden={index === 0 ? 'false' : 'true'}
    />
  ))}
  <figcaption>Personal visual selection · Third-party rights retained</figcaption>
</figure>

<script>
  import { installHeroRotators } from '../scripts/hero-rotator'
  installHeroRotators()
</script>

<style>
  .hero-banner {
    position: relative;
    overflow: hidden;
    aspect-ratio: 40 / 13;
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-soft);
  }

  img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    pointer-events: none;
    transition: opacity 1.2s ease;
  }

  img[data-active='true'] { opacity: 1; }

  figcaption {
    position: absolute;
    inset: auto auto var(--space-3) var(--space-4);
    color: #f7f2eb;
    font-family: var(--font-mono);
    font-size: 0.67rem;
    letter-spacing: 0.08em;
    text-shadow: 0 1px 6px rgb(0 0 0 / 0.65);
  }

  @media (max-width: 40rem) {
    .hero-banner { aspect-ratio: 16 / 8.5; }
    figcaption { inset-inline: var(--space-3); }
  }

  @media (prefers-reduced-motion: reduce) {
    img { transition: none; }
  }
</style>
