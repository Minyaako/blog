---
import AppIcon from './AppIcon.astro'
---

<li class="small-features" data-small-features>
  <button class="nav-link feature-trigger" type="button" aria-expanded="false" aria-controls="small-features-popover">小功能 <span class="feature-chevron"><AppIcon name="lucide:chevron-down" size={16} /></span></button>
  <div class="feature-popover" id="small-features-popover" hidden>
    <a class="nav-link" href="/moments/">动态</a>
    <a class="nav-link" href="/ranking/">榜单</a>
  </div>
</li>

<script>
  // Astro executes this module once. Delegate to the current DOM so client-side
  // navigation cannot leave a newly rendered header with stale or missing handlers.
  const setOpen = (menu: HTMLElement, expanded: boolean, focus: 'first' | 'trigger' | null = null) => {
    const trigger = menu.querySelector<HTMLButtonElement>('.feature-trigger')
    const popover = menu.querySelector<HTMLElement>('.feature-popover')
    if (!trigger || !popover) return
    trigger.setAttribute('aria-expanded', String(expanded))
    popover.hidden = !expanded
    if (focus === 'first') popover.querySelector<HTMLAnchorElement>('a')?.focus()
    if (focus === 'trigger') trigger.focus()
  }
  const closeOutside = (target: EventTarget | null) => {
    document.querySelectorAll<HTMLElement>('[data-small-features]').forEach(menu => {
      if (!(target instanceof Node) || !menu.contains(target)) setOpen(menu, false)
    })
  }

  document.addEventListener('click', event => {
    if (!(event.target instanceof Element)) return
    const trigger = event.target.closest<HTMLButtonElement>('.feature-trigger')
    const menu = trigger?.closest<HTMLElement>('[data-small-features]')
    if (trigger && menu) setOpen(menu, trigger.getAttribute('aria-expanded') !== 'true')
  })
  document.addEventListener('keydown', event => {
    if (!(event.target instanceof Element)) return
    const menu = event.target.closest<HTMLElement>('[data-small-features]')
    if (!menu) return
    if (event.target.matches('.feature-trigger') && ['Enter', ' ', 'ArrowDown'].includes(event.key)) {
      event.preventDefault()
      setOpen(menu, true, 'first')
    } else if (event.key === 'Escape' && menu.querySelector('.feature-trigger')?.getAttribute('aria-expanded') === 'true') {
      event.preventDefault()
      setOpen(menu, false, 'trigger')
    }
  })
  document.addEventListener('pointerdown', event => closeOutside(event.target))
  document.addEventListener('focusin', event => closeOutside(event.target))
  document.addEventListener('astro:before-swap', () => closeOutside(null))
</script>

<style>
  .small-features { position: relative; }
  .feature-trigger { border: 0; background: transparent; cursor: pointer; white-space: nowrap; }
  .feature-chevron { display: inline-flex; flex-shrink: 0; margin-left: var(--space-1); transition: rotate var(--duration-fast); }
  .feature-trigger[aria-expanded='true'] .feature-chevron { rotate: 180deg; }
  .feature-popover { position: absolute; z-index: 30; top: calc(100% + var(--space-2)); right: 0; min-width: 8rem; padding: var(--space-2); border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface-raised); box-shadow: var(--shadow-soft); }
  .feature-popover .nav-link { justify-content: flex-start; }
  @media (prefers-reduced-motion: reduce) { .feature-chevron { transition: none; } }
  @media (max-width: 48rem) {
    .small-features { min-width: 0; }
    .feature-trigger { width: 100%; justify-content: flex-end; padding-inline: 0; font-size: .8rem; }
    .feature-chevron { width: .75rem; margin-left: 2px; }
    .feature-chevron :global(svg) { width: 100%; }
    .feature-popover { right: 0; left: auto; }
  }
</style>
